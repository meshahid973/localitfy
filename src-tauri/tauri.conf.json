{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "localtify",
  "version": "0.4.2",
  "identifier": "com.meshahid973.localitfy",
  "build": {
    "beforeDevCommand": "npm exec vite -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "localtify",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*",
          "$RESOURCE/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "resources": [
      "../pixelart/**/*"
    ]
  }
}
